<Window x:Class="VertexX.AccountWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Vertex X Account" Width="455" Height="520" MinWidth="400" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Background="#101014" Foreground="#F0F0F4" FontFamily="Segoe UI">
 <Window.Resources>
 <Style TargetType="TextBox">
 <Setter Property="Background" Value="#202025"/><Setter Property="Foreground" Value="White"/>
 <Setter Property="BorderBrush" Value="#45454E"/><Setter Property="BorderThickness" Value="1"/>
 <Setter Property="Padding" Value="11"/><Setter Property="Margin" Value="0,6,0,12"/>
 </Style>
 <Style TargetType="PasswordBox">
 <Setter Property="Background" Value="#202025"/><Setter Property="Foreground" Value="White"/>
 <Setter Property="BorderBrush" Value="#45454E"/><Setter Property="BorderThickness" Value="1"/>
 <Setter Property="Padding" Value="11"/><Setter Property="Margin" Value="0,6,0,14"/>
 </Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="35,28">
 <TextBlock Text="VERTEX X" FontSize="21" FontWeight="Bold" Margin="0,0,0,5"/>
 <TextBlock Text="Your private workspace account" Foreground="#AAAAAF" Margin="0,0,0,22"/>
 <TextBlock Text="USERNAME (SIGN UP)" FontSize="10" Foreground="#BCBCC6"/>
 <TextBox x:Name="UsernameInput" MaxLength="20" ToolTip="3-20 letters, numbers, underscores"/>
 <TextBlock Text="EMAIL (SIGN IN AND RECOVERY)" FontSize="10" Foreground="#BCBCC6"/>
 <TextBox x:Name="EmailInput" MaxLength="254"/>
 <TextBlock Text="PASSWORD" FontSize="10" Foreground="#BCBCC6"/>
 <PasswordBox x:Name="PasswordInput" MaxLength="128"/>
 <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
 <Button x:Name="SignInButton" Content="Sign in" Background="#E4E4E8" Foreground="#121216" Click="SignIn_Click" Padding="18,10" Margin="0,0,10,0"/>
 <Button x:Name="SignUpButton" Content="Create account" Background="#303037" Foreground="White" Click="SignUp_Click" Padding="18,10"/>
 </StackPanel>
 <TextBlock x:Name="ResultText" TextWrapping="Wrap" Foreground="#B0B0C3"/>
 <TextBlock Text="Email is used for secure login and recovery; username is your Vertex X profile name." Foreground="#85858D" TextWrapping="Wrap" FontSize="11" Margin="0,22,0,0"/>
 </StackPanel></ScrollViewer>
</Window>
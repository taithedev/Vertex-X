<Window x:Class="VertexX.FindReplaceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Vertex X — Find and Replace" Height="308" Width="510"
 ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Background="#111114" Foreground="#EFEFF3" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#24242B"/><Setter Property="Foreground" Value="#F0F0F4"/>
   <Setter Property="CaretBrush" Value="White"/>
   <Setter Property="BorderBrush" Value="#484852"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,5,0,13"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#2B2B32"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,9,0"/>
  </Style>
 </Window.Resources>
 <StackPanel Margin="24,22">
  <TextBlock Text="Find &amp; Replace" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>
  <TextBlock Text="FIND" FontSize="10" Foreground="#B1B1BE"/>
  <TextBox x:Name="FindInput"/>
  <TextBlock Text="REPLACE WITH" FontSize="10" Foreground="#B1B1BE"/>
  <TextBox x:Name="ReplaceInput"/>
  <CheckBox x:Name="MatchCaseCheck" Content="Match case" Margin="0,0,0,15"/>
  <StackPanel Orientation="Horizontal">
   <Button Content="Find next" Click="FindNext_Click"/>
   <Button Content="Replace" Click="Replace_Click"/>
   <Button Content="Replace all" Click="ReplaceAll_Click"/>
  </StackPanel>
  <TextBlock x:Name="ResultText" Margin="0,11,0,0" FontSize="11" Foreground="#A9A9B6"/>
 </StackPanel>
</Window>
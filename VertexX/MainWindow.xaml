<Window x:Class="VertexX.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Vertex X" Width="1220" Height="765" MinWidth="890" MinHeight="560"
 WindowStartupLocation="CenterScreen" Background="#09090B" Foreground="#EBEBEF"
 FontFamily="Segoe UI" KeyDown="Window_KeyDown" Closing="Window_Closing">
 <Window.Resources>
  <SolidColorBrush x:Key="Surface" Color="#121215"/>
  <SolidColorBrush x:Key="SurfaceRaised" Color="#1A1A1E"/>
  <SolidColorBrush x:Key="Edge" Color="#29292E"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#212126"/>
   <Setter Property="Foreground" Value="#E5E5EB"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="15,9"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
    </ControlTemplate>
   </Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#37373E"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="#A6A6AF"/>
   <Setter Property="Background" Value="#161619"/>
   <Setter Property="Padding" Value="18,11"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="TabItem">
     <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="#29292F"
      BorderThickness="0,0,1,0" Padding="{TemplateBinding Padding}">
      <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="TabBorder" Property="Background" Value="#25252B"/>
       <Setter Property="Foreground" Value="White"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="29"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#101013" BorderBrush="#27272C" BorderThickness="0,0,0,1">
   <Grid Margin="18,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#E6E6EA" CornerRadius="10" Width="35" Height="35" Margin="0,0,13,0">
      <TextBlock Text="V" FontSize="20" FontWeight="Bold" Foreground="#111115"
       HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <StackPanel VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="VERTEX" FontSize="17" FontWeight="Bold"/>
       <TextBlock Text=" X" FontSize="17" FontWeight="Light" Foreground="#A7A7B1"/>
      </StackPanel>
      <TextBlock Text="SCRIPT WORKSPACE" FontSize="9" Foreground="#73737D" FontWeight="SemiBold"/>
     </StackPanel>
     <Border BorderBrush="#414149" BorderThickness="1" CornerRadius="5"
      Margin="16,0,0,0" Padding="7,3" VerticalAlignment="Center">
      <TextBlock Text="BETA 0.4" FontSize="9" Foreground="#A7A7B0"/>
     </Border>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="+  New" Click="New_Click"/>
     <Button Content="Open" Click="Open_Click"/>
     <Button Content="Save" Click="Save_Click"/>
     <Button Content="▶  Execute" Click="Run_Click" Background="#E5E5EB"
      Foreground="#101014" FontWeight="SemiBold"/>
     <Button Content="Account" Click="Account_Click"/>
     <Button Content="Roblox" Click="Roblox_Click"/>
     <Button Content="Updates" Click="Updates_Click"/>
     <Button Content="⚙" Click="Settings_Click" Margin="0" FontSize="17" Padding="13,6"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="60"/>
    <ColumnDefinition Width="215"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#0E0E11" BorderBrush="#29292F" BorderThickness="0,0,1,0">
    <StackPanel Margin="8,16">
     <Border Background="#25252B" CornerRadius="9" Padding="0,11" Margin="0,0,0,9">
      <TextBlock Text="⌘" FontSize="21" HorizontalAlignment="Center" Foreground="White"/>
     </Border>
     <Button Content="+" Padding="0,8" FontSize="20" Margin="0,0,0,8" Click="New_Click"/>
     <Button Content="↻" Padding="0,8" FontSize="19" Margin="0,0,0,8" Click="Refresh_Click"/>
     <Border Background="#36363C" Height="1" Margin="8,15"/>
     <Button Content="⚙" FontSize="17" Padding="0,8" Margin="0" Click="Settings_Click"/>
    </StackPanel>
   </Border>
   <Border Grid.Column="1" Background="#121215" BorderBrush="#2C2C31" BorderThickness="0,0,1,0">
    <DockPanel Margin="15,20,15,14">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="EXPLORER" FontSize="10" FontWeight="Bold" Foreground="#9C9CA6" Margin="6,0,0,17"/>
      <Border Background="#202025" CornerRadius="6" Padding="10,9" Margin="0,0,0,18">
       <TextBlock Text="⌕  Local workspace" FontSize="11" Foreground="#9797A2"/>
      </Border>
      <TextBlock Text="YOUR SCRIPTS" FontSize="10" Foreground="#777781" FontWeight="SemiBold" Margin="5,0,0,10"/>
     </StackPanel>
     <ListBox x:Name="LibraryList" Background="Transparent" Foreground="#D6D6DE"
      BorderThickness="0" FontSize="12" MouseDoubleClick="Library_DoubleClick"
      SelectionMode="Single" HorizontalContentAlignment="Stretch"/>
    </DockPanel>
   </Border>
   <Grid Grid.Column="2" Margin="14">
    <Grid.RowDefinitions>
     <RowDefinition Height="*"/><RowDefinition Height="7"/><RowDefinition Height="195"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#151518" BorderBrush="#29292F" BorderThickness="1" CornerRadius="10">
     <DockPanel>
      <TabControl x:Name="EditorTabs" DockPanel.Dock="Top" Background="#151518"
       BorderThickness="0" SelectionChanged="Tabs_SelectionChanged"/>
     </DockPanel>
    </Border>
    <GridSplitter Grid.Row="1" Height="7" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>
    <Border Grid.Row="2" Background="#121215" BorderBrush="#29292F" BorderThickness="1" CornerRadius="10" Padding="15">
     <DockPanel>
      <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="●" Foreground="#A9A9B2" FontSize="12" Margin="0,0,8,0"/>
        <TextBlock Text="CONSOLE" FontWeight="SemiBold" Foreground="#C6C6CC" FontSize="11"/>
       </StackPanel>
       <Button Grid.Column="1" Content="Clear output" Padding="9,5" Margin="0" Click="Clear_Click"/>
      </Grid>
      <TextBox x:Name="ConsoleOutput" Background="Transparent" Foreground="#CFD0D6"
       BorderThickness="0" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
       VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
     </DockPanel>
    </Border>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#17171A" BorderBrush="#303037" BorderThickness="0,1,0,0">
   <Grid Margin="15,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="StatusText" Text="Ready" FontSize="10" Foreground="#A4A4AD" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="LOCAL LUA  •  WINDOWS  •  F5 TO RUN"
     FontSize="9" Foreground="#8C8C97" VerticalAlignment="Center"/>
   </Grid>
  </Border>
 </Grid>
</Window>
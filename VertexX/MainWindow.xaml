<Window x:Class="VertexX.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Vertex X" Width="1100" Height="720" MinWidth="700" MinHeight="480" Background="#0B0B0D" Foreground="#EEEEF0">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Background" Value="#25252B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
</Window.Resources>
<Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions>
<StackPanel Orientation="Horizontal" Margin="0,0,0,18"><TextBlock Text="◆" FontSize="25" Margin="0,0,12,0"/><StackPanel><TextBlock Text="VERTEX X" FontSize="21" FontWeight="Bold"/><TextBlock Text="Native Lua Workspace" Foreground="#90909A" FontSize="11"/></StackPanel></StackPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><Button Content="Run Lua" Click="Run_Click"/><Button Content="Open" Click="Open_Click"/><Button Content="Save" Click="Save_Click"/><Button Content="Clear Console" Click="Clear_Click"/></StackPanel>
<Border Grid.Row="2" Background="#151519" BorderBrush="#303037" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14"><TextBox x:Name="Editor" Background="Transparent" Foreground="#EDEDF0" BorderThickness="0" FontFamily="Consolas" FontSize="15" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Text="print('Hello from Vertex X!')"/></Border>
<Border Grid.Row="3" Background="#111114" BorderBrush="#303037" BorderThickness="1" CornerRadius="10" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="OUTPUT CONSOLE" FontSize="11" Foreground="#A5A5AE" Margin="0,0,0,10"/><TextBox x:Name="ConsoleOutput" Background="Transparent" Foreground="#CFCFD6" BorderThickness="0" FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></DockPanel></Border>
</Grid></Window>
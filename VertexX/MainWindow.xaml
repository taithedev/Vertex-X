<Window x:Class="VertexX.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Vertex X" Width="1280" Height="820" MinWidth="850" MinHeight="570"
 Background="#0C0C0F" Foreground="#ECECF3" WindowStartupLocation="CenterScreen"
 Loaded="Window_Loaded" Closing="Window_Closing" FontFamily="Segoe UI">
 <Grid>
  <StackPanel x:Name="StartupPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="510">
   <TextBlock Text="VERTEX X" FontSize="28" FontWeight="Bold" Margin="0,0,0,12"/>
   <TextBlock x:Name="StartupMessage" Text="Preparing your workspace…" TextWrapping="Wrap" Foreground="#AAAAB8"/>
   <Button x:Name="RetryButton" Content="Retry" Click="Retry_Click" Visibility="Collapsed" Margin="0,18,0,0" Padding="14,9"/>
  </StackPanel>
  <wv:WebView2 x:Name="Web" Visibility="Hidden" DefaultBackgroundColor="#0C0C0F"/>
 </Grid>
</Window>

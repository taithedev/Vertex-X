<Window x:Class="VertexX.RobloxWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Vertex X — Roblox" Width="480" Height="320" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Background="#111115" Foreground="#E8E8EC">
 <StackPanel Margin="26">
 <TextBlock Text="Roblox profile" FontSize="23" FontWeight="Bold" Margin="0,0,0,10"/>
 <TextBlock Text="Look up a public Roblox profile. This is not account linking." Foreground="#A6A6B2" TextWrapping="Wrap" Margin="0,0,0,16"/>
 <TextBox x:Name="UsernameInput" Background="#232329" Foreground="White" Padding="12" BorderBrush="#44444C" Margin="0,0,0,12"/>
 <StackPanel Orientation="Horizontal">
 <Button x:Name="LookupButton" Content="Find profile" Click="Lookup_Click" Padding="12,8" Margin="0,0,10,0"/>
 <Button x:Name="ProfileButton" Content="Open profile" Click="Profile_Click" Padding="12,8" IsEnabled="False"/>
 </StackPanel>
 <TextBlock x:Name="ResultText" Foreground="#C3C3CC" TextWrapping="Wrap" Margin="0,15,0,0"/>
 <TextBlock Text="Verified linking will require registering an official Roblox OAuth app and using PKCE." Foreground="#888891" TextWrapping="Wrap" FontSize="11" Margin="0,20,0,0"/>
 </StackPanel>
</Window>
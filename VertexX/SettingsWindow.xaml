<Window x:Class="VertexX.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Vertex X Settings" Width="440" Height="290" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#121216" Foreground="#EEEEF0">
<StackPanel Margin="26">
<TextBlock Text="Preferences" FontSize="22" FontWeight="Bold" Margin="0,0,0,22"/>
<TextBlock Text="Editor font size" Foreground="#C3C3CB" Margin="0,0,0,8"/>
<Slider x:Name="FontSizeSlider" Minimum="10" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True" Value="15" Margin="0,0,0,18"/>
<CheckBox x:Name="WrapCheck" Content="Wrap long lines" Margin="0,0,0,20"/>
<Button Content="Apply and save" Background="#E5E5E9" Foreground="#101014" Padding="12" Click="Apply_Click"/>
<TextBlock Text="Settings are stored locally on this Windows account." Foreground="#888892" FontSize="11" Margin="0,14,0,0"/>
</StackPanel></Window>